<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0-windows</TargetFramework><IsTestProject>true</IsTestProject><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup><PackageReference Include="Microsoft.NET.Test.Sdk"/><PackageReference Include="xunit"/><PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all"/><Using Include="Xunit"/><ProjectReference Include="../../src/AgentNetDoctor.Core/AgentNetDoctor.Core.csproj"/><ProjectReference Include="../../src/AgentNetDoctor.Windows/AgentNetDoctor.Windows.csproj"/><ProjectReference Include="../../src/AgentNetDoctor.Adapters/AgentNetDoctor.Adapters.csproj"/>
    <ProjectReference Include="../RepairCrashHost/RepairCrashHost.csproj" ReferenceOutputAssembly="false"/>
    <ProjectReference Include="../../src/AgentNetDoctor.App/AgentNetDoctor.App.csproj"/>
  </ItemGroup>
  <Target Name="CopyCrashHost" AfterTargets="Build">
    <ItemGroup><CrashHostFiles Include="../RepairCrashHost/bin/$(Configuration)/net10.0-windows/*"/></ItemGroup>
    <Copy SourceFiles="@(CrashHostFiles)" DestinationFolder="$(OutDir)crash-host"/>
  </Target>
</Project>

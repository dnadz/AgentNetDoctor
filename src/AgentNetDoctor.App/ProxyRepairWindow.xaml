<Window x:Class="AgentNetDoctor.App.ProxyRepairWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="残留代理检查与恢复" Width="820" Height="720" MinWidth="720" MinHeight="620" WindowStartupLocation="CenterOwner" Background="#F4F7FA" FontFamily="Microsoft YaHei UI" FontSize="14" Closing="Window_Closing">
 <Window.Resources><Style TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,0,10,0"/></Style><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></Window.Resources>
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="检查 VPN 退出后的残留代理" FontSize="24" FontWeight="SemiBold" Foreground="#163A50"/><TextBlock Text="仅检查当前用户的手动系统代理。不修改 DNS、路由、WinHTTP、VPN 或 Agent 配置。" Margin="0,8,0,18" Foreground="#526477"/></StackPanel>
  <Border Grid.Row="1" Background="#FFF2D9" Padding="14" Margin="0,0,0,16"><TextBlock Text="当前包支持检测与修复差异预览，系统代理写入和回滚尚未解锁，需先通过隔离Windows验收。TUN / kill switch / 节点故障无法靠关闭手动代理解决。"/></Border>
  <StackPanel Grid.Row="2">
   <CheckBox x:Name="VpnOffBox" Content="我已正常退出 VPN / 代理客户端，同意检查本机回环端口（不访问公网）" Margin="0,0,0,12"/>
   <WrapPanel><Button x:Name="CheckButton" Content="检查残留代理" Click="Check_Click"/><Button x:Name="ApplyButton" Content="执行修复（未解锁）" Click="Apply_Click" IsEnabled="False"/><Button x:Name="HistoryButton" Content="读取恢复记录" Click="History_Click"/></WrapPanel>
  </StackPanel>
  <Grid Grid.Row="3" Margin="0,18,0,14"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="100"/></Grid.RowDefinitions>
   <TextBox x:Name="DetailsBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="14" BorderBrush="#BDCDD6" Text="点击检查后，仅当静态手动代理指向本机、两次明确拒绝连接、无 PAC / 自动发现或已观察到的策略冲突时，才生成修复差异。超时不作为端口已关闭的证据。"/>
   <TextBlock Grid.Row="1" Text="受保护恢复记录（保存在当前 Windows 用户下，系统重装后可能无法解密）" Margin="0,14,0,8"/>
   <ListBox Grid.Row="2" x:Name="RecordsBox" DisplayMemberPath="Label"/>
  </Grid>
  <DockPanel Grid.Row="4"><Button x:Name="RollbackButton" Content="检查所选恢复记录" Click="Rollback_Click"/><TextBlock x:Name="StateText" Text="尚未修改设置" VerticalAlignment="Center" Foreground="#526477"/></DockPanel>
 </Grid>
</Window>

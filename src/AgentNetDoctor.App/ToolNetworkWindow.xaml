<Window x:Class="AgentNetDoctor.App.ToolNetworkWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="软件连接检查" Width="940" Height="760" MinWidth="820" MinHeight="640" WindowStartupLocation="CenterOwner" Background="#EDF3F6" FontFamily="Microsoft YaHei UI" FontSize="15" Closing="Window_Closing">
 <Window.Resources><Style TargetType="Button"><Setter Property="Padding" Value="18,10"/><Setter Property="Margin" Value="0,0,12,0"/></Style><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="#243E50"/></Style></Window.Resources>
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="检查软件连接" FontSize="26" FontWeight="SemiBold" Foreground="#163C4C"/><TextBlock Text="先检查电脑端，再告诉你下一步。不会自动修改网络设置。" Margin="0,8,0,18"/></StackPanel>
  <ComboBox Grid.Row="1" x:Name="ToolBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Tool_Changed" Padding="10" MaxDropDownHeight="360" Margin="0,0,0,16"/>
  <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,18"><Button x:Name="LocalButton" Content="开始检查" Click="Local_Click" Background="#136C79" Foreground="White"/><Button x:Name="CancelButton" Content="停止检查" Click="Cancel_Click" IsEnabled="False"/></StackPanel>
  <Border Grid.Row="3" Background="White" BorderBrush="#CDDDE3" BorderThickness="1" CornerRadius="9" Padding="22" Margin="0,0,0,18"><StackPanel>
   <TextBlock x:Name="SummaryTitle" Text="准备检查" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12"/>
   <TextBlock x:Name="SummaryDetail" Text="点击“开始检查”即可，不需要填写技术参数。" Margin="0,0,0,14"/>
   <TextBlock Text="下一步" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBlock x:Name="SummaryNext" Text="请先打开遇到问题的软件，再开始检查。"/>
  </StackPanel></Border>
  <Expander Grid.Row="4" x:Name="AdvancedOptions" Header="高级选项与技术报告（需要时再打开）" IsExpanded="False" VerticalAlignment="Stretch">
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,14,8,0">
    <TextBlock x:Name="ToolHint" Margin="0,0,0,12" FontSize="13"/>
    <TextBlock Text="普通检查会检查已配置的本机代理端口，不访问公网。下面的附加测试只有在确认范围并点击按钮后才联网，不发送密钥或调用模型。" Margin="0,0,0,12" FontSize="13"/>
    <TextBlock Text="实际服务根地址（需要了解该软件设置）" Margin="0,0,0,6"/><TextBox x:Name="TargetBox" Padding="8" ToolTip="HTTPS服务根地址，不填密钥或模型请求路径；本机Ollama可使用/api/version。" Margin="0,0,0,12"/>
    <TextBlock Text="现有HTTP代理地址（选填，不清楚就留空）" Margin="0,0,0,6"/><TextBox x:Name="ProxyBox" Padding="8" ToolTip="填写代理客户端提供的真实HTTP入口，不填写密码或订阅链接。" Margin="0,0,0,12"/>
    <CheckBox x:Name="NetworkConsent" Content="同意对上面的服务地址进行额外联网测试，不发送登录信息或调用模型" Margin="0,0,0,12"/>
    <Button x:Name="TestButton" Content="测试填写的服务地址" Click="Test_Click" IsEnabled="False" HorizontalAlignment="Left"/>
    <TextBlock Text="先完成普通检查后才能测试服务。结果只说明本次连接，不代表软件登录或业务正常。" FontSize="12" Margin="0,10,0,12"/>
    <Button x:Name="ExportButton" Content="保存完整技术报告" Click="Export_Click" IsEnabled="False" HorizontalAlignment="Left"/>
    <TextBox x:Name="ReportBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="260" Padding="12" Background="White" FontSize="12" BorderBrush="#BDCDD6" Margin="0,12,0,0" Text="尚未生成技术报告。"/>
   </StackPanel></ScrollViewer>
  </Expander>
  <TextBlock Grid.Row="5" x:Name="StatusText" Text="准备好了，不会自动修改设置。" Margin="0,14,0,0" Foreground="#526B79" FontSize="13"/>
 </Grid>
</Window>
